---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { url } from '../lib';
---

<Base title="Not Found">
  <div class="container notfound">
    <p class="code">404</p>
    <p class="muted">ページが見つかりません。</p>
    <a class="btn" href={url('/')}><Icon name="arrow-left" />トップへ戻る</a>
  </div>
</Base>
