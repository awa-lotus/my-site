---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import PostList from '../components/PostList.astro';
import ProjectCard from '../components/ProjectCard.astro';
import SectionHead from '../components/SectionHead.astro';
import { PROFILE, SITE } from '../consts';
import { getPosts, getProjects } from '../data';
import { url } from '../lib';

const allPosts = await getPosts();
const projects = await getProjects();
const books = await getCollection('books');
const items = await getCollection('items');

const posts = allPosts.slice(0, 5);
// 注目のプロジェクトを先頭に
const works = [...projects.filter((p) => p.data.featured), ...projects.filter((p) => !p.data.featured)].slice(0, 6);

const index = [
  { href: '/projects/', label: 'Works', count: projects.length },
  { href: '/blog/', label: 'Blog', count: allPosts.length },
  { href: '/books/', label: 'Books', count: books.length },
  { href: '/items/', label: 'Items', count: items.length },
];
const pad = (n: number) => String(n).padStart(2, '0');
const buildDate = new Date().toISOString().slice(0, 10).replaceAll('-', '.');
const [head, ...rest] = SITE.title.split('-');
---

<Base>
  <section class="intro container">
    <span class="cross cross-tl" aria-hidden="true"></span>
    <span class="cross cross-tr" aria-hidden="true"></span>
    <span class="sys" aria-hidden="true">Portfolio / {buildDate}</span>
    <span class="glow" aria-hidden="true"></span>
    <svg class="geo" viewBox="0 0 600 600" aria-hidden="true">
      <circle class="geo-ring" cx="300" cy="300" r="290" />
      <circle class="geo-ring geo-dash" cx="300" cy="300" r="214" />
      <path class="geo-arc" d="M 300 10 A 290 290 0 0 1 590 300" />
      <line x1="0" y1="600" x2="600" y2="0" />
      <line x1="300" y1="0" x2="300" y2="600" class="geo-thin" />
      <circle class="geo-dot" cx="300" cy="300" r="4" />
    </svg>
    <h1 class="wordmark reveal">
      {rest.length > 0 ? <>{head}<span class="wm-dash">-</span>{rest.join('-')}</> : SITE.title}
    </h1>
    <div class="intro-meta reveal">
      <p class="intro-desc">{SITE.description}</p>
      <ul class="intro-index">
        {index.map((i) => (
          <li><a href={url(i.href)}><span>{i.label}</span><span class="n">{pad(i.count)}</span></a></li>
        ))}
      </ul>
    </div>
    <a class="scroll-cue" href="#works" aria-label="Works へ">Scroll</a>
  </section>

  <div class="container">
    <section class="section" id="works">
      <SectionHead num="01" title="Works" label="作ったもの" href={url('/projects/')} />
      <div class="grid">{works.map((project) => <ProjectCard project={project} />)}</div>
    </section>
  </div>

  <div class="marquee" aria-hidden="true">
    <div class="marquee-track">
      {[0, 1].map(() => (
        <span>{index.map((i) => <>{i.label}<i>/</i></>)}</span>
      ))}
    </div>
  </div>

  <div class="band band-flush">
    <div class="container">
      <section class="section">
        <SectionHead num="02" title="Writing" label="書いたこと" href={url('/blog/')} />
        <PostList posts={posts} />
      </section>
    </div>
  </div>

  <div class="container">
    <section class="section about-teaser">
      <SectionHead num="03" title="About" label="人となり" href={url('/about/')} more="Read more" />
      <div class="about-grid scroll-in">
        {PROFILE.bio && <p class="about-bio">{PROFILE.bio}</p>}
        <dl class="spec">
          <dt>Skills</dt>
          <dd><ul>{PROFILE.skills.map((s) => <li>{s}</li>)}</ul></dd>
          <dt>Interests</dt>
          <dd>Books · Tools · Writing</dd>
        </dl>
      </div>
    </section>
  </div>
</Base>
