---
import Base from '../../layouts/Base.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { getProjects } from '../../data';

const projects = await getProjects();
---

<Base title="Projects" description="作ったものの一覧">
  <h1>Projects</h1>
  <p class="lead">これまでに作ったもの。</p>
  <div class="list">{projects.map((project) => <ProjectCard project={project} />)}</div>
</Base>
