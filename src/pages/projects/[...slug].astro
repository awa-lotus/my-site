---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { getProjects } from '../../data';

export async function getStaticPaths() {
  const projects = await getProjects();
  return projects.map((project) => ({ params: { slug: project.id }, props: { project } }));
}

const { project } = Astro.props;
const { Content } = await render(project);
const { title, description, tech, repo, url, image } = project.data;
---

<Base title={title} description={description}>
  <article class="prose">
    <h1>{title}</h1>
    <p class="lead">{description}</p>
    {tech.length > 0 && <ul class="tags">{tech.map((t) => <li class="tag">{t}</li>)}</ul>}
    <p>
      {repo && <a href={repo}>Repository</a>}
      {repo && url && ' · '}
      {url && <a href={url}>Demo</a>}
    </p>
    {image && <img src={image} alt="" />}
    <Content />
  </article>
</Base>
