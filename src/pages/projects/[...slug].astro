---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import { getProjects } from '../../data';
import { url as siteUrl } from '../../lib';

export async function getStaticPaths() {
  const projects = await getProjects();
  return projects.map((project) => ({ params: { slug: project.id }, props: { project } }));
}

const { project } = Astro.props;
const { Content } = await render(project);
const { title, description, tech, repo, url, image, date } = project.data;
---

<Base title={title} description={description}>
  <article class="narrow">
    <header class="article-head">
      <a class="back" href={siteUrl('/projects/')}><Icon name="arrow-left" />Works</a>
      <p class="eyebrow">Work · {date.getFullYear()}</p>
      <h1 class="page-title">{title}</h1>
      <p class="page-lead">{description}</p>
      {tech.length > 0 && <div class="article-meta"><ul class="chips">{tech.map((t) => <li class="chip">{t}</li>)}</ul></div>}
      {(repo || url) && (
        <div class="ext-links">
          {url && <a class="btn btn-primary" href={url}>Demo <Icon name="arrow-up-right" /></a>}
          {repo && <a class="btn" href={repo}><Icon name="github" />Repository</a>}
        </div>
      )}
    </header>
    {image && <img class="hero-image" src={image} alt="" />}
    <div class="prose"><Content /></div>
  </article>
</Base>
