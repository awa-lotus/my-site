---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import ProductCard from '../../components/ProductCard.astro';

const items = await getCollection('items');
const entries = await Promise.all(
  items.map(async (item) => ({ item, Content: (await render(item)).Content })),
);
const categories = [...new Set(items.map((i) => i.data.category))].sort();
---

<Base title="Items" description="愛用しているもの">
  <h1>Items</h1>
  <p class="lead">普段使っているもの・おすすめのもの。</p>
  {categories.map((category) => (
    <section>
      <h2>{category}</h2>
      <div class="list">
        {entries
          .filter(({ item }) => item.data.category === category)
          .map(({ item, Content }) => (
            <ProductCard
              title={item.data.name}
              subtitle={item.data.brand}
              image={item.data.image}
              rating={item.data.rating}
              asin={item.data.asin}
              links={item.data.links}
            >
              <div class="prose"><Content /></div>
            </ProductCard>
          ))}
      </div>
    </section>
  ))}
</Base>
