---
import Icon from './Icon.astro';

interface Props {
  num: string;
  title: string;
  href?: string;
  more?: string;
}

const { num, title, href, more = 'View all' } = Astro.props;
---

<div class="section-head">
  <h2 class="section-title"><span class="num">{num}</span>{title}</h2>
  {href && <a class="more" href={href}>{more} <Icon name="arrow-right" class="arrow" /></a>}
</div>
