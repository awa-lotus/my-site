---
import Icon from './Icon.astro';

interface Props {
  num: string;
  title: string;
  label?: string;
  href?: string;
  more?: string;
}

const { num, title, label, href, more = 'View all' } = Astro.props;
---

<div class="section-head scroll-in">
  <div>
    <p class="section-eyebrow">// <span class="num">{num}</span>{label && ` — ${label}`}</p>
    <h2 class="section-title">{title}</h2>
  </div>
  {href && <a class="more" href={href}>{more} <Icon name="arrow-right" class="arrow" /></a>}
</div>
