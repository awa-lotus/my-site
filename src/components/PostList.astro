---
import type { CollectionEntry } from 'astro:content';
import { formatDate, url } from '../lib';

interface Props {
  posts: CollectionEntry<'blog'>[];
}

const { posts } = Astro.props;
---

{posts.length === 0 ? (
  <p class="empty">まだ記事はありません。</p>
) : (
  <ul class="posts">
    {posts.map((post) => (
      <li class="post-row scroll-in">
        <a href={url(`/blog/${post.id}/`)}>
          <time class="post-date" datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time>
          <span class="post-title">
            {post.data.title}
            <span class="post-desc">{post.data.description}</span>
          </span>
          <span class="post-tags">{post.data.tags.map((t) => `#${t}`).join(' ')}</span>
        </a>
      </li>
    ))}
  </ul>
)}
