---
import type { CollectionEntry } from 'astro:content';
import { url } from '../lib';

interface Props {
  project: CollectionEntry<'projects'>;
}

const { project } = Astro.props;
const { title, description, tech, date, image } = project.data;
// 画像がないときのサムネイル用の頭文字(英語は単語の頭、日本語は先頭 1 字)
const initials = /^[\x00-\x7f]+$/.test(title)
  ? title.split(/\s+/).map((w) => w[0]).join('').slice(0, 3).toUpperCase()
  : [...title][0];
---

<article class="project scroll-in">
  <div class="project-thumb">
    {image ? (
      <img src={image} alt="" loading="lazy" />
    ) : (
      <div class="thumb-ph" aria-hidden="true">
        <span class="thumb-initials">{initials}</span>
      </div>
    )}
  </div>
  <div class="project-body">
    <div class="project-head">
      <h3><a href={url(`/projects/${project.id}/`)}>{title}</a></h3>
      <span class="project-year">{date.getFullYear()}</span>
    </div>
    <p>{description}</p>
    {tech.length > 0 && <p class="project-tech">{tech.join(', ')}</p>}
  </div>
</article>
