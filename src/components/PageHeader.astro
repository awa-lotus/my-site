---
interface Props {
  eyebrow: string;
  title: string;
  lead?: string;
}

const { eyebrow, title, lead } = Astro.props;
---

<header class="page-head">
  <p class="eyebrow reveal">{eyebrow}</p>
  <h1 class="page-title reveal">{title}</h1>
  {lead && <p class="page-lead reveal">{lead}</p>}
</header>
