---
import '@fontsource-variable/geist/wght.css';
import '@fontsource/geist-mono/400.css';
import '@fontsource/geist-mono/500.css';
import '@fontsource/zen-kaku-gothic-new/400.css';
import '@fontsource/zen-kaku-gothic-new/500.css';
import '@fontsource/zen-kaku-gothic-new/700.css';
import '../styles/global.css';
import Icon from '../components/Icon.astro';
import { SITE, NAV } from '../consts';
import { url } from '../lib';

interface Props {
  title?: string;
  description?: string;
}

const { title, description = SITE.description } = Astro.props;
const pageTitle = title ? `${title} | ${SITE.title}` : SITE.title;
const canonical = new URL(Astro.url.pathname, Astro.site);
const current = Astro.url.pathname;
const isActive = (href: string) =>
  href === '/' ? current.replace(/\/$/, '') === url('') : current.startsWith(url(href));
---

<!doctype html>
<html lang={SITE.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={url('/favicon.svg')} />
    <link rel="sitemap" href={url('/sitemap-index.xml')} />
    <link rel="alternate" type="application/rss+xml" title={SITE.title} href={url('/rss.xml')} />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#000000" media="(prefers-color-scheme: dark)" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
  </head>
  <body>
    <header class="site-header">
      <div class="container header-inner">
        <a class="logo" href={url('/')}><Icon name="lotus" />{SITE.title}</a>
        <nav class="site-nav" aria-label="メイン">
          {NAV.map((item) => (
            <a href={url(item.href)} aria-current={isActive(item.href) ? 'page' : undefined}>
              {item.label}
            </a>
          ))}
        </nav>
      </div>
    </header>
    <div class="progress" aria-hidden="true"></div>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <div class="container">
        <div class="footer-grid">
          <div class="footer-brand">
            <a class="logo" href={url('/')}><Icon name="lotus" />{SITE.title}</a>
            <p>{SITE.description}</p>
          </div>
          <div class="footer-col">
            <h2>Sitemap</h2>
            <ul>
              {NAV.map((item) => <li><a href={url(item.href)}>{item.label}</a></li>)}
              <li><a href={url('/rss.xml')}>RSS</a></li>
            </ul>
          </div>
        </div>
        <div class="footer-bottom">
          <p class="disclosure">
            当サイトはアフィリエイトプログラム(Amazon アソシエイトなど)に参加しており、紹介リンクから購入されると運営者に報酬が入ることがあります。
          </p>
          <p class="copy">&copy; {new Date().getFullYear()} {SITE.title}<span class="build">Last build {new Date().toISOString().slice(0, 10)}</span></p>
        </div>
      </div>
    </footer>
    <script>
      // 作品サムネイルの文字がカーソルに合わせて立体的に傾く。マウス操作かつ動きを減らす設定でないときだけ
      const fine = matchMedia('(pointer: fine) and (prefers-reduced-motion: no-preference)');
      if (fine.matches) {
        // カードはリンクが全面を覆っているので、カード全体でカーソルを拾ってサムネイルに渡す
        for (const card of document.querySelectorAll<HTMLElement>('.project')) {
          const el = card.querySelector<HTMLElement>('.project-thumb');
          if (!el) continue;
          card.addEventListener('pointermove', (e) => {
            const r = el.getBoundingClientRect();
            const x = Math.min(Math.max((e.clientX - r.left) / r.width, 0), 1);
            const y = Math.min(Math.max((e.clientY - r.top) / r.height, 0), 1);
            el.style.setProperty('--mx', x.toFixed(3));
            el.style.setProperty('--my', y.toFixed(3));
          });
          card.addEventListener('pointerleave', () => {
            el.style.removeProperty('--mx');
            el.style.removeProperty('--my');
          });
        }
      }
    </script>
  </body>
</html>
